{
  "sources": {
    "trt4": {
      "id": "trt4",
      "name": "TRT4 - Certidão de Ações Trabalhistas",
      "enabled": true,
      "api": {
        "url": "https://api.infosimples.com/api/v2/consultas/tribunal/trt4/ceat",
        "timeout": 600
      },
      "requirements": {
        "accepts": ["CPF", "CNPJ"],
        "requiresName": false,
        "requiresBirthdate": false,
        "requiresMotherName": false
      },
      "parameters": {
        "cpf": "{{cpf}}",
        "cnpj": "{{cnpj}}",
        "nome": "{{nome}}",
        "token": "{{token}}"
      },
      "conditionalParameters": {
        "nome": {
          "condition": "documentType === 'CPF'",
          "required": false
        }
      },
      "fileProcessing": {
        "supportedTypes": ["pdf", "html"],
        "customProcessor": "trt4"
      },
      "storage": {
        "bucket": "arquivos-teste",
        "pathTemplate": "{{user_id}}/{{batch_id}}/{{source}}_{{timestamp}}.{{extension}}"
      }
    },
    "policia_federal": {
      "id": "policia_federal",
      "name": "Polícia Federal - Antecedentes Criminais",
      "enabled": true,
      "api": {
        "url": "https://api.infosimples.com/api/v2/consultas/antecedentes-criminais/pf/emit",
        "timeout": 600
      },
      "requirements": {
        "accepts": ["CPF"],
        "requiresName": true,
        "requiresBirthdate": true,
        "requiresMotherName": false
      },
      "parameters": {
        "cpf": "{{cpf}}",
        "nome": "{{nome}}",
        "birthdate": "{{data_nascimento}}",
        "nome_mae": "{{nome_mae}}",
        "token": "{{token}}"
      },
      "fileProcessing": {
        "supportedTypes": ["pdf"],
        "customProcessor": null
      },
      "storage": {
        "bucket": "arquivos-teste",
        "pathTemplate": "{{user_id}}/{{batch_id}}/{{source}}_{{timestamp}}.{{extension}}"
      }
    },
    "receita_federal": {
      "id": "receita_federal",
      "name": "Receita Federal - Certidão CNPJ",
      "enabled": true,
      "api": {
        "url": "https://api.infosimples.com/api/v2/consultas/receita-federal/cnpj",
        "timeout": 600
      },
      "requirements": {
        "accepts": ["CNPJ"],
        "requiresName": false,
        "requiresBirthdate": false,
        "requiresMotherName": false
      },
      "parameters": {
        "cnpj": "{{cnpj}}",
        "token": "{{token}}"
      },
      "fileProcessing": {
        "supportedTypes": ["pdf"],
        "customProcessor": null
      },
      "storage": {
        "bucket": "arquivos-teste",
        "pathTemplate": "{{user_id}}/{{batch_id}}/{{source}}_{{timestamp}}.{{extension}}"
      }
    }
  },
    },
    "cndt-tst": {
      "id": "tst",
      "name": "Certidão negativa de débitos trabalhistas - Certidão CNPJ",
      "enabled": true,
      "api": {
        "url": "https://api.infosimples.com/api/v2/consultas/tribunal/tst/cndt",
        "timeout": 600
      },
      "requirements": {
        "accepts": ["CNPJ", "CPF"],
        "requiresName": false,
        "requiresBirthdate": false,
        "requiresMotherName": false
      },
      "parameters": {
        "cnpj": "{{cnpj}}",
        "cpf": "{{cpf}}",
        "token": "{{token}}"
      },
      "fileProcessing": {
        "supportedTypes": ["pdf"],
        "customProcessor": null
      },
      "storage": {
        "bucket": "arquivos-teste",
        "pathTemplate": "{{user_id}}/{{batch_id}}/{{source}}_{{timestamp}}.{{extension}}"
      }
    }
  },
  "global": {
    "defaultTimeout": 600,
    "maxRetries": 3,
    "retryDelay": 1000
  }
}
